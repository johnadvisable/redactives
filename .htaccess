# QR-code packaging URLs (from REDACTIVES MASTER FILE) redirect into the
# matching product drawer on the homepage. Apache only — if hosting moves
# off Apache, port these to that platform's native redirect config instead.
# Targets are domain-relative (no hardcoded host) so they work on any
# domain this ends up deployed to.

Redirect 301 /qrcode/1/ /#nh-biomimetic-face-serum
Redirect 301 /qrcode/2/ /#hc-biomimetic-face-serum
Redirect 301 /qrcode/3/ /#vb-biomimetic-face-serum
Redirect 301 /qrcode/4/ /#cp-biomimetic-face-serum
Redirect 301 /qrcode/5/ /#ra-biomimetic-face-serum
Redirect 301 /qrcode/6/ /#nh-biomimetic-face-cream
Redirect 301 /qrcode/7/ /#hc-biomimetic-face-cream
Redirect 301 /qrcode/8/ /#vb-biomimetic-face-cream
Redirect 301 /qrcode/9/ /#cp-biomimetic-face-cream
Redirect 301 /qrcode/10/ /#ra-biomimetic-face-cream
